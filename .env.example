# Charan Chatbot Environment Configuration
# Copy this file to .env.local for local development

NEXT_PUBLIC_APP_NAME="Charan Chatbot"

# AI Model API Keys (Supports Gemini & OpenAI APIs)
# Get a free Gemini API Key from: https://aistudio.google.com/
GEMINI_API_KEY=""
OPENAI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"

# Web Search Configuration
SEARCH_PROVIDER="duckduckgo"

# Optional Firebase Authentication Configuration
# Enable Google Sign-In & Email Auth in Firebase Console: https://console.firebase.google.com/
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
